  "item": [
    {
      "name": "1. Autenticación (/api/auth)",
      "description": "Endpoints públicos de registro y login, y endpoint autenticado de logout.",
      "item": [
        {
          "name": "1.1 Registrar Cliente",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Generar un email único para evitar colisiones en ejecuciones repetidas",
                  "const timestamp = Date.now();",
                  "pm.collectionVariables.set('cliente_email', `cliente_${timestamp}@farmayopin.com`);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('Respuesta contiene token, id y rol CLIENTE', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('token');",
                  "    pm.expect(res).to.have.property('id');",
                  "    pm.expect(res.rol).to.eql('CLIENTE');",
                  "    pm.expect(res.email).to.eql(pm.collectionVariables.get('cliente_email'));",
                  "    ",
                  "    // Guardar token y ID de cliente en variables de colección",
                  "    pm.collectionVariables.set('token_cliente', res.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{cliente_nombre}}\",\n  \"email\": \"{{cliente_email}}\",\n  \"password\": \"{{cliente_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "1.2 Login Cliente",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Login exitoso devuelve token JWT y rol CLIENTE', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('token');",
                  "    pm.expect(res.rol).to.eql('CLIENTE');",
                  "    pm.collectionVariables.set('token_cliente', res.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
