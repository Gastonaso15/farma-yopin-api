    {
      "name": "3. Carrito de Compras (/api/carrito)",
      "description": "Gestión del carrito activo del cliente, agregado, modificación, eliminación y checkout / pago.",
      "item": [
        {
          "name": "3.1 Ver Carrito (Cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Respuesta contiene estructura de carrito', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res).to.have.property('id');",
                  "    pm.expect(res).to.have.property('total');",
                  "    pm.expect(res).to.have.property('items');",
                  "    pm.expect(res.items).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/carrito",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carrito"
              ]
            }
          },
          "response": []
        },
        {
          "name": "3.2 Agregar Ítem al Carrito (Cliente)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Parsear producto_id como entero en el body si es necesario",
                  "const prodId = Number(pm.collectionVariables.get('producto_id')) || 1;",
                  "pm.request.body.raw = JSON.stringify({ productoId: prodId, cantidad: 3 });"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Ítem agregado y total recalculado', function () {",
                  "    const res = pm.response.json();",
                  "    pm.expect(res.items.length).to.be.at.least(1);",
                  "    pm.expect(res.total).to.be.above(0);",
                  "    ",
                  "    // Guardar el id del ítem para usar en modificación y eliminación",
                  "    const item = res.items[res.items.length - 1];",
                  "    pm.collectionVariables.set('item_id', item.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token_cliente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/carrito/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "carrito",
                "items"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productoId\": \"{{producto_id}}\",\n  \"cantidad\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "3.3 Modificar Cantidad de Ítem en Carrito (Cliente)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Cantidad actualizada y total recalculado', function () {",
                  "    const res = pm.response.json();",
                  "    const itemModificado = res.items.find(i => i.id.toString() === pm.collectionVariables.get('item_id').toString());",
                  "    if (itemModificado) {",
                  "        pm.expect(itemModificado.cantidad).to.eql(5);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
